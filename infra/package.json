{
  "name": "@world/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-assets.ts",
    "synth": "npm run build:assets && cdk synth",
    "diff": "npm run build:assets && cdk diff",
    "deploy": "npm run build:assets && cdk deploy --require-approval never",
    "destroy": "cdk destroy",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  }
}
