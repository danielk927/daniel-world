# All optional. Copy to your host's environment settings.
PORT=3001
# Comma-separated list of page origins allowed to connect. Unset = allow any (fine for local dev).
ALLOWED_ORIGINS=https://daniel.example.com
# Set to 1 behind exactly one reverse proxy that appends the address it got each request from to
# X-Forwarded-For (CloudFront does), so per-IP limits see the real client: the last entry is taken.
TRUST_PROXY=1
# Path prefix for the HTTP routes when a CDN forwards e.g. /ws* to this server.
BASE_PATH=/ws
